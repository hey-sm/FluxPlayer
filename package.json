{
  "name": "fluxplayer",
  "productName": "FluxPlayer",
  "version": "2.0.0-alpha.1",
  "description": "FluxPlayer — 沉浸式桌面音乐播放器",
  "author": "FluxPlayer",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/hey-sm/FluxPlayer",
  "repository": {
    "type": "git",
    "url": "https://github.com/hey-sm/FluxPlayer.git"
  },
  "bugs": {
    "url": "https://github.com/hey-sm/FluxPlayer/issues"
  },
  "packageManager": "pnpm@10.33.0",
  "desktopName": "FluxPlayer.desktop",
  "main": "out/main/index.mjs",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller",
      "sharp"
    ],
    "overrides": {
      "js-yaml": "4.3.1"
    },
    "patchedDependencies": {
      "react-glass-ui@1.2.2": "patches/react-glass-ui@1.2.2.patch"
    }
  },
  "scripts": {
    "native:wallpaper": "node scripts/build-wallpaper-helper.mjs",
    "predev": "pnpm native:wallpaper",
    "prebuild": "pnpm native:wallpaper",
    "dev": "electron-vite dev",
    "start": "pnpm dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "format": "oxfmt --check",
    "format:write": "oxfmt",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "smoke": "node scripts/smoke.mjs",
    "record:fixtures": "node scripts/record-fixtures.mjs",
    "icons:mac": "node scripts/gen-mac-icon.mjs",
    "build:win": "pnpm build && electron-builder --win",
    "build:win:dir": "pnpm build && electron-builder --win dir",
    "build:mac": "pnpm icons:mac && pnpm build && electron-builder --mac",
    "build:linux": "pnpm build && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@gsap/react": "2.1.2",
    "@playwright/test": "1.61.1",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.66.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "NeteaseCloudMusicApi": "4.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "gsap": "^3.15.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.24.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-glass-ui": "1.2.2",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "three": "0.185.1",
    "three-text": "^0.6.5",
    "typescript": "^5.8.0",
    "vite": "^8.1.3",
    "vitest": "^3.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  }
}
